{
  "name": "pc-monitor-plugin",
  "version": "1.0.0",
  "description": "Stream Deck plugin that shows CPU/GPU temperature and load, RAM usage and network speed from the Ptty PC Monitor service.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.hollobar.ptty-pc-monitor\"",
    "link": "streamdeck link com.hollobar.ptty-pc-monitor.sdPlugin",
    "pack": "rollup -c && streamdeck pack com.hollobar.ptty-pc-monitor.sdPlugin --output ../dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^22.20.5",
    "rollup": "^4.65.0",
    "tslib": "^2.8.1",
    "typescript": "~5.9.0"
  }
}
